{
  "name": "sketchx",
  "private": true,
  "description": "sketchX: a real-time drawing game against a CNN.",
  "scripts": {
    "dev": "node dev-server.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/input.css -o public/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i src/input.css -o public/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@upstash/redis": "^1.41.0"
  }
}
